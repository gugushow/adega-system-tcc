# Copie este arquivo para .env (cp .env.example .env) e ajuste se quiser.
# Valores APENAS de exemplo para desenvolvimento local. Nunca use em produção.
# Se mudar MYSQL_DATABASE, MYSQL_USER, MYSQL_PASSWORD ou MYSQL_PORT, ajuste também a connection
# string da API nos User Secrets (veja "Backend" no README).
# A porta 3307 evita conflito com um MySQL instalado direto na máquina, que normalmente usa a 3306.

MYSQL_ROOT_PASSWORD=root_dev
MYSQL_DATABASE=adega
MYSQL_USER=adega
MYSQL_PASSWORD=adega_dev
MYSQL_PORT=3307
