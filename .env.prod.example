# Variáveis do docker-compose.prod.yml. Copie para .env.prod (que NÃO vai para o Git) e preencha os valores.
#   cp .env.prod.example .env.prod
#
# As senhas e a chave JWT ficam VAZIAS de propósito: enquanto não forem preenchidas,
# o "docker compose" se recusa a subir (mensagem "defina ... no .env.prod"). Assim ninguém
# coloca o sistema no ar com um valor de exemplo que está publicado no GitHub.
#
# Dica: nas senhas use letras e números (evite ; e aspas, que quebram a connection string).
# Para gerar um valor aleatório: openssl rand -hex 32

# Banco de dados (só acessível dentro do Docker)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=adega
MYSQL_USER=adega
MYSQL_PASSWORD=

# Chave que assina os tokens de login: pelo menos 32 caracteres. Trocar derruba todas as sessões.
JWT_SECRET=

# Senha do admin (admin@adega.local) na primeira subida: 8+ caracteres, com letras e números.
ADMIN_INITIAL_PASSWORD=

# Porta onde o sistema fica disponível na máquina (http://servidor:8080).
APP_PORT=8080
