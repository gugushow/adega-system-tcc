# Variáveis do docker-compose.demo.yml. Copie para .env.demo (que NÃO vai para o Git) e preencha os valores.
#   cp .env.demo.example .env.demo
#
# É só para DEMONSTRAÇÃO local, mas as senhas ficam VAZIAS de propósito, como no .env.prod.example:
# enquanto não forem preenchidas, o "docker compose" se recusa a subir (mensagem "defina ... no .env.demo").
# Não reaproveite as senhas da produção.
#
# Nas senhas use letras e números (evite ; e aspas, que quebram a connection string).
# Para gerar um valor aleatório: openssl rand -hex 32

# Banco de dados da demo (adega_demo, só acessível dentro do Docker)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Chave que assina os tokens de login: pelo menos 32 caracteres.
JWT_SECRET=

# Senha do admin (admin@adega.local) na demo: 8+ caracteres, com letras e números.
ADMIN_INITIAL_PASSWORD=

# Senha dos 4 usuários demo (vendedores e estoquistas): 8+ caracteres, com letras e números.
DEMO_USERS_PASSWORD=

# Porta da demo no computador (http://localhost:8081). Diferente da produção (8080) para os dois conviverem.
DEMO_PORT=8081
